[max]
# Токен бота мессенджера МАХ (нужен мосту для отправки в чаты MAX)
token = "XXXXXXXXXXXXXXXXXXXXXXXX"

[telegram]
# Включить мост Telegram -> MAX (yes/no)
on = "yes"
# Токен Telegram-бота (получить у @BotFather)
token = "123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

[tg_to_max]
# Таблица пересылки: ID отправителя в Telegram = ID группового чата MAX.
# Когда бот получает сообщение от указанного TG_ID, программа пересылает
# его (текст и/или фото) в соответствующий чат MAX.
# Можно указать несколько строк — по одной на каждого отправителя.
"111111111" = "-1001234567890"
